{
  "name": "ScoutingApp2026",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace server",
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "start:remote": "npm run start:remote --workspace server",
    "dev:remote": "concurrently \"npm run dev --workspace client\" \"npm run dev:remote --workspace server\"",
    "analysis:generate-fake": "python data-analysis/generate_fake_data.py",
    "analysis:extract-source": "python data-analysis/01_extract_source.py",
    "analysis:02": "python data-analysis/02_clean_normalize.py",
    "analysis:03": "python data-analysis/03_feature_engineering.py",
    "analysis:04": "python data-analysis/04_team_aggregation.py",
    "analysis:05": "python data-analysis/05_picklist_scores.py",
    "analysis:06": "python data-analysis/06_export_app_payloads.py",
    "analysis:full:fake-local": "python data-analysis/run_fake_local_full.py",
    "analysis:full:docker": "python data-analysis/run_docker_full.py",
    "import:logs": "tsx server/scripts/importLogs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:check": "eslint ."
  },
  "workspaces": [
    "client",
    "server",
    "database",
    "requests"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4201VitruvianBots/scouting-app-2023.git"
  },
  "devDependencies": {
    "@types/chroma-js": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "concurrently": "^8.2.2",
    "dotenv-mono": "^1.3.13",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react-select": "^5.8.0",
    "recharts": "^2.15.1"
  }
}
