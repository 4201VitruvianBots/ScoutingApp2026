{
  "name": "ScoutingApp2026",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace server",
    "dev:data": "python data-analysis/run_fake_mode.py --no-seed-mongo --use-match-schedule --verify-picklist-artifacts",
    "dev:data:db": "python data-analysis/run_fake_mode.py --seed-mongo --use-match-schedule --verify-picklist-artifacts",
    "dev": "npm run dev:data && concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:db": "npm run dev:data:db && concurrently \"npm run dev --workspace client\" \"cross-env DEV_USE_DOCKER=1 npm run dev --workspace server\"",
    "start:remote": "npm run start:remote --workspace server",
    "dev:remote": "concurrently \"npm run dev --workspace client\" \"npm run dev:remote --workspace server\"",
    "analysis:real": "python data-analysis/run_real_mode.py",
    "analysis:fake": "python data-analysis/run_fake_mode.py",
    "import:logs": "tsx server/scripts/importLogs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:check": "eslint ."
  },
  "workspaces": [
    "client",
    "server",
    "database",
    "requests"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4201VitruvianBots/scouting-app-2023.git"
  },
  "devDependencies": {
    "@types/chroma-js": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "concurrently": "^8.2.2",
    "dotenv-mono": "^1.3.13",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react-select": "^5.8.0",
    "recharts": "^2.15.1"
  }
}
